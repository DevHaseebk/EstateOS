{
  "name": "estateos",
  "private": true,
  "workspaces": ["backend", "admin", "super-admin", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n frontend,admin,super-admin,backend \"npm run dev:frontend\" \"npm run dev:admin\" \"npm run dev:super-admin\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:admin": "npm run dev -w admin",
    "dev:super-admin": "npm run dev -w super-admin",
    "dev:backend": "npm run dev -w backend",
    "proxy": "caddy run --config dev/https/Caddyfile --adapter caddyfile",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "next": "^16.4.2"
  },
  "engines": { "node": "^20.19.0 || ^22.13.0 || >=24.0.0" }
}
