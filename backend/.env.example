# EstateOS backend (API). Copy to .env for local development; in staging/production inject these from the host's
# secret store. Never commit real values. Phase 7a: NODE_ENV=production refuses to start with development defaults.
NODE_ENV=development
PORT=4003
BIND_HOST=127.0.0.1
MONGODB_URI=
# Exact HTTPS origins of the two management apps (production: real hosts, never *.localhost).
OWNER_ORIGIN=https://admin.estateos.localhost
SUPER_ADMIN_ORIGIN=https://control.estateos.localhost
# Tenant sites are <slug>.<PUBLIC_SITE_DOMAIN>.
PUBLIC_SITE_DOMAIN=sites.estateos.localhost
# Three different random values, each at least 32 characters (e.g. `openssl rand -base64 48`).
INTERNAL_API_KEY=
PUBLIC_API_KEY=
CSRF_SIGNING_KEY=

# Media storage: local (development, uses MEDIA_DIR or backend/.media-dev) or s3 (required in production).
MEDIA_STORAGE=local
# MEDIA_DIR=
# S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO). The bucket must be PRIVATE.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only one backend instance runs the activation reconciler and staged-media cleanup; set false on extra instances.
RUN_BACKGROUND_JOBS=true
# Optional: licensed Hero defaults manifest.
# HERO_DEFAULTS_PATH=

# Backup and restore (npm run backup / npm run restore). 32 bytes as 64 hex characters or base64; keep it outside Git,
# outside the database and outside the bucket. Losing it makes every backup unreadable.
# BACKUP_ENCRYPTION_KEY=
# RESTORE_TARGET_URI=            (an EMPTY database, never the source)
# RESTORE_KEY=backups/estateos-YYYYMMDD-HHMMSS.bak   or   RESTORE_FILE=/path/to/file.bak

# CLI only: inject from a secret manager or concealed operator environment.
# BOOTSTRAP_OPERATOR= BOOTSTRAP_NAME= BOOTSTRAP_EMAIL= BOOTSTRAP_PASSWORD=
# RECOVERY_OPERATOR= RECOVERY_EMAIL= RECOVERY_VERIFICATION_METHOD= RECOVERY_ATTESTED=YES
# RECOVERY_SECOND_APPROVER= (required for Super Admin recovery)
